# Copy this file to `.env` in the same directory (backend/.env) and fill in
# real values. Every variable here is read in config/settings.py — nothing
# else needs to be set. Defaults shown are what's used if a variable is
# omitted (safe for local dev, NOT safe for production).

# --- Django core ------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Database (PostgreSQL) ---------------------------------------------------
DB_NAME=omnicare
DB_USER=omnicare_user
DB_PASSWORD=omnicare_pass
DB_HOST=localhost
DB_PORT=5432

# --- CORS --------------------------------------------------------------------
# The origin(s) the Next.js frontend runs on. Comma-separate multiple values.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Google Gemini (ARIA) ----------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# As of mid-2026, newly issued keys use Google's "Auth key" format (prefixed
# AQ.Ab) rather than the older AIza... "Standard key" format — both have
# existed depending on when you generate one, but Standard keys are being
# phased out, so a new key will almost certainly look like AQ.Ab...
# Without this set, ARIA falls back to a graceful "unreachable" reply instead
# of a 500 error — but no real triage/summarization will work until it's set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Rate limiting ------------------------------------------------------------
# Applies only to the ARIA chat endpoint (POST /api/ai-assistant/chat/),
# since it calls a paid external API per-request.
AI_CHAT_THROTTLE_RATE=30/minute
